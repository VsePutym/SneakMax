.wrapperTitle{
	display: flex;
	align-items: center;
	color: #051129;
	justify-content: space-between;
	.btnClose{
		color: #c9184a;
		margin-right: 20px;
	}
}
.form{
	display: flex;
	flex-direction: column;
	gap: 10px;
	max-width: 600px;
	width: 100%;
	min-width: 330px;
	margin: 0 auto;
	padding: 20px;
	color: #051129;
}
.input{
	border: 1px solid #051129;
	border-radius: 5px;
	padding: 15px;
	margin-bottom: 25px;
}

.inputPhone{
	border: 1px solid #051129;
	border-radius: 5px;
	padding: 15px;
}

@media (max-width: 450px) {
	.form{
		max-width: 100%;
		min-width: 100%;
		padding: 0;
	}
}
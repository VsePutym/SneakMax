.container {
	margin-top: 50px;
	text-align: center;
	display: flex;
	justify-content: center;
	align-items: center;
}

.page {
	margin-right: 10px;
	cursor: pointer;
	font-weight: normal;
	padding: 5px 10px;
	border-radius: 5px;
	transition: background-color 0.3s ease;
}

.page:hover {
	background-color: #f0f0f0;
}

.current {
	font-weight: bold;
	color: #007bff; /* или любой другой цвет для выделения */
}

.button {
	cursor: pointer;
	padding: 5px 10px 0 10px;
	background-color: #051129;
	border: 1px solid #051129;
	color: white;
	border-radius: 5px;
	margin: 0 10px;
	transition: all 0.3s ease;
}

.button:hover {
	border: #c9184a 1px solid;
	background-color: #c9184a;
	color: white;
}

.ellipsis {
	margin-right: 10px;
	font-weight: normal;
}

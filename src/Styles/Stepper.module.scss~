.stepper{
	display: flex;
	justify-content: center;
	padding: 130px;
	background-color: white;
	h2{
		margin-bottom: 20px;
		color: rgba(68, 75, 88, 1);
	}
}

.wrapperSteper{
	max-width: 800px;
}
@media (max-width: 650px) {
	.wrapperSteper{
		max-width: 100%;
		width: 100%;
	}
	.stepper{
		padding: 50px;
	}
}
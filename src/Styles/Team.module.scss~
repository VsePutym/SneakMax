.section{
	background: linear-gradient(to right, #051129 0%, #051129 40%, #000000 100%);
	position: relative;
}

.elipse{
	position: absolute;
	right: 0;
	top: 0;
	z-index: 1;
}

.container{
	z-index: 3000;
	margin: 0 auto;
	max-width: 1200px;
	padding: 60px 0;
	
}
.title{
	margin-left: 20px;
	margin-bottom: 40px;
}

.wrapperTeam{
	margin-right: 20px;
	margin-left: 20px;
	display: grid;
	grid-template-columns: 1fr 1fr 1fr;
	gap: 20px;
}
.imgWrapper{
	width: 100%;
	max-width: 350px;
	height: 400px;
	display: flex;
	justify-content: center;
	align-items: center;
	overflow: hidden;
}
.img{
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.name{
	margin-top: 20px;
	font-family: IntroRegular sans-serif;
	font-weight: bold;
	font-size: 24px;
	line-height: 24px;
}

.role{
	font-family: IntroBook sans-serif;
	font-weight: normal;
	font-size: 16px;
	line-height: 16px;
	margin-top: 20px;
}

@media (max-width: 850px) {
	.wrapperTeam{
		grid-template-columns: 1fr 1fr;
	}
	.elipse{
		width: 300px;
	}
}

@media (max-width: 600px) {
	.elipse{
		width: 200px;
	}
	.wrapperTeam{
		justify-items: center;
		grid-template-columns: 1fr;
		gap: 40px;
		margin-right: 10px;
		margin-left: 10px;
	}
	.imgWrapper{
		width: 100%;
		height: auto;
	}
}

@media (max-width: 450px) {
	.elipse{
		width: 130px;
	}
}
.container{
	max-width: 1200px;
	margin: 0 auto;
	color: #051129;
	box-shadow: 1px 4px 12px rgba(0, 0, 0, 0.1), 2px 8px 16px rgba(0, 0, 0, 0.1);
	padding: 40px 100px;
}
.wrapperContainer{
	padding-bottom: 60px;
	padding-top: 60px;
}
.title{
	color: rgba(68, 75, 88, 1);
	font-size: 30px;
	line-height: 30px;
	font-family: IntroBold;
	font-weight: bold;
	margin-bottom: 20px;
}
.subtitle{
	color: rgba(128, 128, 128, 1);
	font-size: 16px;
	font-family: IntroBook sans-serif;
	font-weight: normal;
	padding-bottom: 10px;
	border-bottom: 1px solid rgba(128, 128, 128, 1);
}
.titleType{
	margin-top: 20px;
	margin-bottom: 20px;
	color: rgba(68, 75, 88, 1);
	font-size: 16px;
	line-height: 24px;
	font-family: IntroBook;
	font-weight: normal;
}
.wrapperCard{
	display: grid;
	grid-template-columns: 1fr 1fr 1fr;
}
.wrapperBtns{
	margin-top: 40px;
	padding-top: 20px;
	border-top: 1px solid rgba(128, 128, 128, 1);
	font-family: IntroBook sans-serif;
	font-weight: bold;
	color: rgba(128, 128, 128, 1);
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.wrapperSizes{
	display: flex;
	
}
.checkboxSize{
	margin-right: 70px;
}
.imgSize{
	width: 100%;
	margin-top: 10px;
}

.textAria{
	margin-top: 50px;
}

.form{
	margin-top: 20px;
	max-width: 500px;
}

.containerForm{
	box-shadow: 1px 4px 12px rgba(0, 0, 0, 0.1), 2px 8px 16px rgba(0, 0, 0, 0.1);
	padding: 20px;
	margin-top: 30px;
}
.titleForm{
	margin-bottom: 15px;
	font-family: IntroBold sans-serif;
}
.containerForm{
	p{
		color: rgba(128, 128, 128, 1);
		font-size: 16px;
		font-family: IntroBook sans-serif;
	}
}

@media (max-width: 1240px) {
	.wrapperCard{
		grid-template-columns: 1fr 1fr;
		justify-items: center;
		gap: 20px;
	}
	.container{
		margin: 15px;
	}
	.checkboxSize{
		margin-right: 25px;
	}
}
@media (max-width: 730px) {
	.wrapperSizes{
		flex-direction: column;
	}
	.checkboxSize{
		margin-right: 20px;
	}
}
@media (max-width: 860px) {
.container{
	padding: 20px;
}
}
@media (max-width: 410px) {
	.wrapperBtns{
		flex-direction: column;
		gap: 20px;
	}
	.title{
		font-size: 25px;
	}
}
@media (max-width: 560px) {
	.wrapperCard{
		grid-template-columns: 1fr;
		gap: 20px;
	}
}
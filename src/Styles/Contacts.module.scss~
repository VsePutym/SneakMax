.section{
	background-color: rgba(243, 246, 246, 1);
}
.container{
	max-width: 1200px;
	margin: 0 auto;
	display: flex;
	justify-content: space-between;
	padding-top: 60px;
	padding-bottom: 60px;
}
.title{
	font-size: 30px;
	color: rgba(68, 75, 88, 1);
	margin-bottom: 60px;
}
.wrapperHelps{
	align-items: center;
	margin-bottom: 35px;
	display: flex;
}
.helperImg{
	margin-left: 10px;
	width: 24px;
	height: 24px;
	box-shadow: 1px 4px 12px rgba(0, 0, 0, 0.1), 2px 8px 16px rgba(0, 0, 0, 0.1);
	border-radius: 50%;
}

.ContactsOne{
	margin-bottom: 35px;
}
.ContactsOne,.ContactsTwo {
	a{
		color: rgba(68, 75, 88, 1);
		font-size: 30px;
		font-family: IntroRegular sans-serif;
	}
	p{
		color: rgba(68, 75, 88, 1);
		font-size: 18px;
		line-height: 25px;
	}
	.subTitleMin{
		color: rgba(178, 181, 187, 1);
		font-size: 14px;
		margin-bottom: 18px;
	}
}
.subTitleMin{
	color: rgba(178, 181, 187, 1);
	font-size: 14px;
}
.wrapperSocial{
	margin-top: 35px;
}
.wrapperMap{
	position: relative;
	overflow: hidden;
	box-shadow: 1px 4px 12px rgba(0, 0, 0, 0.1), 2px 8px 16px rgba(0, 0, 0, 0.1);
	border-radius: 5px;
	max-width: 600px;
	width: 600px;
}
.map{
	width: 100%;
	height: 100%;
}

@media (max-width: 1290px) {
.container{
flex-direction: column;
	padding: 20px;
}
	.wrapperMap{
		margin-top: 50px;
		max-width: 1200px;
		width: 100%;
	}
	.map{
		width: 100%;
		height: 600px;
	}
}

@media (max-width: 450px) {
	.title{
		font-size: 20px;
	}
	.map{
		height: 300px;
	}
}
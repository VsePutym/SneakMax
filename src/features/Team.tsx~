import style from '@style/Team.module.scss'
import { useEffect } from 'react'
import { useAppDispatch, useAppSelector } from '../Hooks/Hooks.ts'
import { getTeam } from '../Redux/Actions/teamAction.ts'
import { selectorsTeam } from '../Redux/Selectors/team.ts'
import elipse from '@images/teams/elipse.svg'

const Team = () => {
	const dispatch = useAppDispatch()
	const team = useAppSelector(selectorsTeam.getAllTeam)
	useEffect(() => {
		dispatch(getTeam())
	}, [])

	return (
		<section className={style.section}>
			<div className={style.container}>
				<img className={style.elipse} src={elipse} alt='img' />
				<h1 className={style.title}>Наша команда</h1>
				<ul className={style.wrapperTeam}>
					{team.map(item => (
						<li className={style.Card} key={item.id}>
							<div className={style.imgWrapper}>
								<img className={style.img} src={item.imgUrl} alt={item.name} />
							</div>
							<p className={style.name}>{item.name}</p>
							<p className={style.role}>{item.role}</p>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

export default Team

import { Stepper, Step, StepLabel, StepContent, Paper } from '@mui/material'
import * as React from 'react'
import { Box, Button, Typography } from '@mui/material/'
import styles from '@style/Stepper.module.scss'
import ExpandMoreIcon from '@mui/icons-material/ExpandMore'
import ExpandLessIcon from '@mui/icons-material/ExpandLess'
import { StepIcon } from '@mui/material'

const steps = [
	{
		label: 'Выбор и добавление в корзину',
		description: `Выберите понравившиеся кроссовки из нашего ассортимента. Мы предлагаем только оригинальную продукцию от ведущих брендов. Добавьте выбранные модели в корзину для оформления заказа.`
	},
	{
		label: 'Оформление заказа и оплата',
		description: `Укажите свои данные для доставки, выберите удобный способ оплаты и завершите оформление заказа. Все данные надёжно защищены, а оплата проходит через проверенные системы.`
	},
	{
		label: 'Доставка до двери',
		description: `Мы оперативно отправляем ваш заказ с помощью надёжных курьерских служб. Вам останется только получить и наслаждаться вашей покупкой!`
	}
]

const StepperFC = () => {
	const [activeStep, setActiveStep] = React.useState(0)

	const handleNext = () => {
		setActiveStep(prevActiveStep => prevActiveStep + 1)
	}

	const handleBack = () => {
		setActiveStep(prevActiveStep => prevActiveStep - 1)
	}

	const handleReset = () => {
		setActiveStep(0)
	}

	return (
		<div className={styles.stepper}>
			<section>
				<h2>Доставка и оплата</h2>
				<Box className={styles.wrapperSteper}>
					<Stepper activeStep={activeStep} orientation='vertical'>
						{steps.map((step, index) => (
							<Step key={step.label}>
								<StepLabel StepIconComponent={props => <StepIcon {...props} />}>
									{step.label}
								</StepLabel>
								<StepContent>
									<Typography
										sx={{ textAlign: 'start', color: 'rgba(68, 75, 88, 1)' }}
									>
										{step.description}
									</Typography>
									<Box sx={{ mb: 2 }}>
										<Button
											variant='contained'
											onClick={handleNext}
											sx={{ mt: 1, mr: 1, color: 'white' }}
										>
											{index === steps.length - 1 ? (
												'Конец'
											) : (
												<ExpandMoreIcon sx={{ color: 'white' }} />
											)}
										</Button>
										<Button
											disabled={index === 0}
											onClick={handleBack}
											sx={{ mt: 1, mr: 1 }}
										>
											<ExpandLessIcon />
										</Button>
									</Box>
								</StepContent>
							</Step>
						))}
					</Stepper>
					{activeStep === steps.length && (
						<Paper
							square
							elevation={0}
							sx={{ p: 3, color: 'rgba(68, 75, 88, 1)' }}
						>
							<Typography>
								Мы доставим кроссовки в кратчайшие сроки, чтобы вы могли
								насладиться удобством и стилем.
							</Typography>
							<Button
								variant='contained'
								onClick={handleReset}
								sx={{ mt: 1, mr: 1 }}
							>
								Заново
							</Button>
						</Paper>
					)}
				</Box>
			</section>
		</div>
	)
}

export default StepperFC
